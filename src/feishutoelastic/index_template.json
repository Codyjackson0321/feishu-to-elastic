{
  "version": 2,
  "index_patterns": ["logs-feishu.audit-*"],
  "data_stream": {},
  "priority": 200,
  "composed_of": [
    "logs@mappings",
    "logs@settings",
    "ecs@mappings",
    "logs@custom",
    "logs-feishu.audit@custom"
  ],
  "ignore_missing_component_templates": [
    "logs@custom",
    "logs-feishu.audit@custom"
  ],
  "_meta": {
    "managed_by": "feishutoelastic",
    "description": "Feishu behavior audit logs mapped to ECS"
  },
  "template": {
    "settings": {
      "index.mode": "logsdb",
      "index.default_pipeline": "logs-feishu.audit"
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "message": { "type": "match_only_text" },
        "ecs": {
          "properties": {
            "version": { "type": "keyword", "ignore_above": 1024 }
          }
        },
        "event": {
          "properties": {
            "kind": { "type": "keyword", "ignore_above": 1024 },
            "module": { "type": "keyword", "ignore_above": 1024 },
            "dataset": { "type": "keyword", "ignore_above": 1024 },
            "provider": { "type": "keyword", "ignore_above": 1024 },
            "action": { "type": "keyword", "ignore_above": 1024 },
            "category": { "type": "keyword", "ignore_above": 1024 },
            "type": { "type": "keyword", "ignore_above": 1024 },
            "outcome": { "type": "keyword", "ignore_above": 1024 },
            "id": { "type": "keyword", "ignore_above": 1024 },
            "ingested": { "type": "date" },
            "original": { "type": "keyword", "index": false, "doc_values": false }
          }
        },
        "error": {
          "properties": {
            "message": { "type": "match_only_text" }
          }
        },
        "user": {
          "properties": {
            "id": { "type": "keyword", "ignore_above": 1024 },
            "name": {
              "type": "keyword",
              "ignore_above": 1024,
              "fields": { "text": { "type": "match_only_text" } }
            },
            "full_name": {
              "type": "keyword",
              "ignore_above": 1024,
              "fields": { "text": { "type": "match_only_text" } }
            },
            "target": {
              "properties": {
                "id": { "type": "keyword", "ignore_above": 1024 },
                "group": {
                  "properties": {
                    "id": { "type": "keyword", "ignore_above": 1024 }
                  }
                }
              }
            }
          }
        },
        "organization": {
          "properties": {
            "id": { "type": "keyword", "ignore_above": 1024 },
            "name": {
              "type": "keyword",
              "ignore_above": 1024,
              "fields": { "text": { "type": "match_only_text" } }
            }
          }
        },
        "source": {
          "properties": {
            "ip": { "type": "ip" },
            "address": { "type": "keyword", "ignore_above": 1024 },
            "mac": { "type": "keyword", "ignore_above": 1024 },
            "geo": {
              "properties": {
                "continent_name": { "type": "keyword", "ignore_above": 1024 },
                "country_iso_code": { "type": "keyword", "ignore_above": 1024 },
                "country_name": { "type": "keyword", "ignore_above": 1024 },
                "region_iso_code": { "type": "keyword", "ignore_above": 1024 },
                "region_name": { "type": "keyword", "ignore_above": 1024 },
                "city_name": { "type": "keyword", "ignore_above": 1024 },
                "location": { "type": "geo_point" }
              }
            },
            "as": {
              "properties": {
                "number": { "type": "long" },
                "organization": {
                  "properties": {
                    "name": {
                      "type": "keyword",
                      "ignore_above": 1024,
                      "fields": { "text": { "type": "match_only_text" } }
                    }
                  }
                }
              }
            }
          }
        },
        "device": {
          "properties": {
            "id": { "type": "keyword", "ignore_above": 1024 },
            "manufacturer": { "type": "keyword", "ignore_above": 1024 },
            "model": {
              "properties": {
                "identifier": { "type": "keyword", "ignore_above": 1024 }
              }
            }
          }
        },
        "user_agent": {
          "properties": {
            "original": {
              "type": "keyword",
              "ignore_above": 1024,
              "fields": { "text": { "type": "match_only_text" } }
            },
            "name": { "type": "keyword", "ignore_above": 1024 },
            "version": { "type": "keyword", "ignore_above": 1024 },
            "os": {
              "properties": {
                "name": {
                  "type": "keyword",
                  "ignore_above": 1024,
                  "fields": { "text": { "type": "match_only_text" } }
                },
                "type": { "type": "keyword", "ignore_above": 1024 },
                "version": { "type": "keyword", "ignore_above": 1024 }
              }
            }
          }
        },
        "url": {
          "properties": {
            "original": {
              "type": "wildcard",
              "fields": { "text": { "type": "match_only_text" } }
            },
            "full": {
              "type": "wildcard",
              "fields": { "text": { "type": "match_only_text" } }
            },
            "scheme": { "type": "keyword", "ignore_above": 1024 },
            "domain": { "type": "keyword", "ignore_above": 1024 },
            "port": { "type": "long" },
            "path": { "type": "wildcard" },
            "query": { "type": "keyword", "ignore_above": 1024 },
            "fragment": { "type": "keyword", "ignore_above": 1024 }
          }
        },
        "file": {
          "properties": {
            "name": { "type": "keyword", "ignore_above": 1024 }
          }
        },
        "related": {
          "properties": {
            "ip": { "type": "ip" },
            "user": { "type": "keyword", "ignore_above": 1024 }
          }
        },
        "feishu": {
          "properties": {
            "audit": {
              "properties": {
                "event_id": { "type": "keyword", "ignore_above": 1024 },
                "event_module": { "type": "integer" },
                "terminal_type": { "type": "integer" },
                "terminal": { "type": "keyword", "ignore_above": 1024 },
                "city": { "type": "keyword", "ignore_above": 1024 },
                "operator": {
                  "properties": {
                    "type": { "type": "integer" },
                    "type_name": { "type": "keyword", "ignore_above": 1024 },
                    "value": { "type": "keyword", "ignore_above": 1024 },
                    "app_id": { "type": "keyword", "ignore_above": 1024 },
                    "app_name": { "type": "keyword", "ignore_above": 1024 },
                    "name": {
                      "properties": {
                        "default": { "type": "keyword", "ignore_above": 1024 },
                        "en_us": { "type": "keyword", "ignore_above": 1024 },
                        "ja_jp": { "type": "keyword", "ignore_above": 1024 },
                        "zh_cn": { "type": "keyword", "ignore_above": 1024 }
                      }
                    }
                  }
                },
                "department_ids": { "type": "keyword", "ignore_above": 1024 },
                "objects": {
                  "properties": {
                    "type": { "type": "keyword", "ignore_above": 1024 },
                    "type_name": { "type": "keyword", "ignore_above": 1024 },
                    "value": { "type": "keyword", "ignore_above": 1024 },
                    "name": { "type": "keyword", "ignore_above": 1024 },
                    "owner": { "type": "keyword", "ignore_above": 1024 },
                    "detail": { "type": "flattened" }
                  }
                },
                "details": { "type": "flattened" },
                "details_display": { "type": "flattened" },
                "extend": { "type": "flattened" },
                "client_context": { "type": "flattened" },
                "recipients": { "type": "flattened" }
              }
            }
          }
        }
      }
    }
  }
}
